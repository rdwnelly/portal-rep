{
  "name": "portal-rep",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3008",
    "build": "next build",
    "start": "next start -p 3008",
    "lint": "eslint --max-warnings 0",
    "test:rules": "npx -y firebase-tools@14 emulators:exec --only firestore --project demo-portal-rep \"node --test tests/rules/firestore.rules.test.mjs\"",
    "emulators": "npx -y firebase-tools@14 emulators:start --only auth,firestore --project demo-portal-rep",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx -y firebase-tools@14 emulators:exec --only auth,firestore --project demo-portal-rep \"playwright test\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
