rules_version = '2';

// =============================================================================
// PORTAL REP — Firestore Security Rules
//
// Portal sederhana: kumpulan link aplikasi kerja + agenda bersama.
//
//  • Semua orang (tanpa login) : baca link aplikasi & agenda; tambah/ubah/hapus agenda.
//  • IT_ADMIN                  : + kelola link aplikasi.
//
// Agenda sengaja terbuka untuk siapa saja. Karena tidak ada login yang bisa dipakai
// sebagai penjaga, SATU-SATUNYA pertahanan agenda adalah validasi bentuk data di bawah:
// field yang diizinkan, tipe, panjang teks, dan format tanggal/jam. Ini mencegah isian
// sampah atau data raksasa, tetapi tidak mencegah orang mengubah/menghapus agenda.
//
// Role dibaca dari whitelist/{email} yang hanya bisa diubah lewat Firebase Console.
// Email wajib terverifikasi agar akun palsu dengan email admin tidak memperoleh role.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identitas & role (hanya untuk mengelola link aplikasi) ----------
    function verified() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function authEmail() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      let path = /databases/$(database)/documents/whitelist/$(authEmail());
      return verified()
        && exists(path)
        && get(path).data.active == true
        && get(path).data.role == 'IT_ADMIN';
    }

    // ---------- Validasi ----------
    function str(v, max) {
      return v is string && v.size() <= max;
    }

    function optStr(d, key, max) {
      return !(key in d) || str(d[key], max);
    }

    // ---------- Whitelist (penentu admin) ----------
    // Hanya bisa diubah dari Firebase Console (Admin SDK melewati aturan ini).
    match /whitelist/{userEmail} {
      allow get: if verified() && userEmail == authEmail();
      allow list, write: if false;
    }

    // ---------- Link aplikasi ----------
    function validApp() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'title', 'shortCode', 'description', 'fullDetails', 'category', 'iconName', 'url',
          'internalUrl', 'status', 'allowedRoles', 'badgeText', 'colorTheme', 'stats',
          'lastUpdated', 'order'
        ])
        && str(d.title, 120)
        && str(d.url, 500)
        && d.url.matches('^https?://.+')
        && d.status in ['ONLINE', 'MAINTENANCE', 'UPDATED', 'OFFLINE']
        && d.category in ['OPERASIONAL', 'KEUANGAN', 'GUDANG_POS', 'MEDIA_KREATIF', 'ADMINISTRASI']
        && optStr(d, 'description', 600)
        && optStr(d, 'shortCode', 40);
    }

    match /apps/{appId} {
      allow read: if true;
      allow create, update: if isAdmin() && validApp();
      allow delete: if isAdmin();
    }

    // ---------- Agenda (terbuka untuk semua orang) ----------
    function validEvent() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'title', 'description', 'date', 'timeStart', 'timeEnd', 'location', 'category',
          'status', 'organizer', 'targetAudience', 'isHighlight', 'notes', 'createdAt', 'createdBy'
        ])
        && d.keys().hasAll(['title', 'date', 'timeStart', 'location', 'category', 'status'])
        && str(d.title, 150) && d.title.size() > 0
        && str(d.date, 10) && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && str(d.timeStart, 5) && d.timeStart.matches('^[0-2][0-9]:[0-5][0-9]$')
        && (!('timeEnd' in d) || (str(d.timeEnd, 5) && d.timeEnd.matches('^[0-2][0-9]:[0-5][0-9]$')))
        && str(d.location, 200)
        && d.category in ['CULTURE_EVENT', 'HOMESTAY_TOUR', 'EXECUTIVE_MEETING',
                          'COMMUNITY_WORKSHOP', 'SYSTEM_MAINTENANCE', 'GENERAL_AGENDA']
        && d.status in ['UPCOMING', 'ONGOING', 'COMPLETED', 'CANCELLED']
        && optStr(d, 'description', 2000)
        && optStr(d, 'organizer', 120)
        && optStr(d, 'targetAudience', 200)
        && optStr(d, 'notes', 1000)
        && optStr(d, 'createdAt', 40)
        && optStr(d, 'createdBy', 120)
        && (!('isHighlight' in d) || d.isHighlight is bool);
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update: if validEvent();
      allow delete: if true;
    }

    // Semua koleksi lain (data fitur lama) tertutup.
  }
}
